--- !u!114 &479031661
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 479031660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84b89abddea939942895b23b18253089, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelRoot: {fileID: 132282469}
  canvasTransform: {fileID: 479031663}
  angleOffsetDegrees: 45
  distanceFromCenter: 2
  fixedHeight: 1.3
  titleText: {fileID: 1888706829}
  bodyText: {fileID: 1012114209}
  promptText: {fileID: 645892998}
  practiceLane: 1
  practiceRow: 0
  practiceEndLane: 3
  resolveBuffer: 1.5
  retryUntilSuccess: 1
  nextSceneName: MusicSelectUI
  steps:
  - title: "\uD48D\uB958\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4"
    body: "\uBD80\uCC44\uB97C \uD718\uB458\uB7EC \uB0A0\uC544\uC624\uB294 \uB178\uD2B8\uB97C
      \uCCD0\uB0B4\uB294 VR \uB9AC\uB4EC\uAC8C\uC784\uC785\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70\uB97C
      \uB2F9\uAE30\uBA74 \uB2E4\uC74C \uC124\uBA85\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    hasPractice: 0
    practiceType: 0
    holdDuration: 0
  - title: "\uCE58\uAE30 (Hit)"
    body: "\uBD80\uCC44\uB97C \uC811\uC740 \uC0C1\uD0DC\uB85C, \uC815\uBA74\uC5D0\uC11C
      \uC624\uB294 \uB178\uD2B8\uB97C \uD5A5\uD574 \uCCD0\uB0C5\uB2C8\uB2E4.\n\uD2B8\uB9AC\uAC70\uB97C
      \uB2F9\uAE30\uBA74 \uC608\uC2DC \uB178\uD2B8\uAC00 \uB0A0\uC544\uC635\uB2C8\uB2E4."
    hasPractice: 1
    practiceType: 2
    holdDuration: 0
  - title: "\uBCA0\uAE30 (Slashing)"
    body: "\uBD80\uCC44\uB97C \uD3B8 \uC0C1\uD0DC\uB85C, \uD654\uC0B4\uD45C \uBC29\uD5A5\uC744
      \uB530\uB77C \uB300\uAC01\uC120\uC73C\uB85C \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4."
    hasPractice: 1
    practiceType: 0
    holdDuration: 0
  - title: "\uBD80\uCE58\uAE30 (Fanning)"
    body: "\uBD80\uCC44\uB97C \uD3B8 \uC0C1\uD0DC\uB85C, \uD654\uC0B4\uD45C\uAC00
      \uAC00\uB9AC\uD0A4\uB294 \uBC29\uD5A5\uC744 \uD5A5\uD574 \uBD80\uCC44\uC9C8\uD558\uB4EF
      \uBC00\uC5B4\uB0C5\uB2C8\uB2E4."
    hasPractice: 1
    practiceType: 1
    holdDuration: 0
  - title: "\uCCB4\uB825 (HP)"
    body: "\uB178\uD2B8\uB97C \uB193\uCE58\uBA74 \uCCB4\uB825\uC774 10 \uC904\uC5B4\uB4E4\uC5B4\uC694.
      \uCCB4\uB825\uC774 0\uC774 \uB418\uBA74 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uACE1\uC774
      \uB05D\uB098\uBC84\uB9AC\uB2C8 \uC8FC\uC758\uD558\uC138\uC694.\n(\uC9C0\uAE08\uC740
      \uC5F0\uC2B5 \uC911\uC774\uB77C \uC2E4\uC81C\uB85C \uCCB4\uB825\uC774 \uC904\uC9C0\uB294
      \uC54A\uC544\uC694)"
    hasPractice: 0
    practiceType: 0
    holdDuration: 0
  - title: "\uB871\uB178\uD2B8 - \uC811\uD798"
    body: "\uBD80\uCC44\uB97C \uC811\uC740 \uC0C1\uD0DC\uB85C \uB178\uD2B8\uC5D0
      \uC0B4\uC9DD \uB2FF\uC73C\uBA74 \uD640\uB4DC\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\uC911\uC694\uD55C
      \uAC74 \uADF8 \uB2E4\uC74C\uC774\uC5D0\uC694 - \uAC00\uC774\uB4DC\uB77C\uC778\uC744
      \uB530\uB77C\uAC00\uB294 \uB0B4\uB0B4 \uBD80\uCC44\uB97C \uC811\uC740 \uC0C1\uD0DC\uB85C
      \uC720\uC9C0\uD574\uC57C \uD569\uB2C8\uB2E4."
    hasPractice: 1
    practiceType: 5
    holdDuration: 3
  - title: "\uB871\uB178\uD2B8 - \uD3BC\uCE68"
    body: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uAC19\uC740
      \uBC29\uC2DD\uC73C\uB85C \uBD80\uCC44\uB97C \uD3BC\uCE5C \uCC44 \uC720\uC9C0\uD574\uBD05\uC2DC\uB2E4."
    hasPractice: 1
    practiceType: 6
    holdDuration: 3
  - title: "\uBCBD (Wall)"
    body: "\uACF5\uACA9\uD560 \uC218 \uC5C6\uB294 \uC7A5\uC560\uBB3C\uC785\uB2C8\uB2E4.
      \uBA38\uB9AC\uC5D0 \uB2FF\uC73C\uBA74 \uBBF8\uC2A4 \uCC98\uB9AC\uB418\uB2C8
      \uBAB8\uC744 \uC6C0\uC9C1\uC5EC \uD53C\uD558\uC138\uC694."
    hasPractice: 1
    practiceType: 4
    holdDuration: 0
  - title: "\uC900\uBE44 \uC644\uB8CC!"
    body: "\uC774\uC81C \uACE1\uC744 \uC120\uD0DD\uD574 \uD50C\uB808\uC774\uB97C
      \uC2DC\uC791\uD574\uBCFC\uAE4C\uC694?"
    hasPractice: 0
    practiceType: 0
    holdDuration: 0
